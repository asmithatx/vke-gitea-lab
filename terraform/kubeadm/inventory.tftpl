# Generated by terraform/kubeadm — do not edit by hand.
[controlplane]
${controlplane.hostname} ansible_host=${controlplane.main_ip} private_ip=${controlplane.internal_ip} vultr_instance_id=${controlplane.id}

[workers]
%{ for w in workers ~}
${w.hostname} ansible_host=${w.main_ip} private_ip=${w.internal_ip} vultr_instance_id=${w.id}
%{ endfor ~}

[k8s:children]
controlplane
workers

[k8s:vars]
ansible_user=root
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
vultr_region=${region}
vultr_vpc_id=${vpc_id}
